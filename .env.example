# Copy this file to `.env` for local development.
# `.env` is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=job-platform
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API process
# Bound to loopback for local development.
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Host ports published by Compose (loopback only). Inside containers the
# application uses postgres:5432 and redis:6379 instead.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
DASHBOARD_HOST_PORT=3000

# ---------------------------------------------------------------------------
# PostgreSQL
# Host port defaults to 5433 because 5432 is commonly used by a local
# PostgreSQL install. The container still listens on 5432 internally.
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=job_platform
POSTGRES_USER=job_platform
POSTGRES_PASSWORD=change-me-in-local-env

# ---------------------------------------------------------------------------
# Redis
# Bound to loopback. Not a public internet service.
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# Workers
# One job at a time per process. Scale with more worker processes / Compose replicas.
# ---------------------------------------------------------------------------
JOB_LEASE_TIMEOUT_SECONDS=60

# Worker liveness. TTL must be >= 2 * interval.
# last_seen_at is sampled slower than the Redis heartbeat.
WORKER_HEARTBEAT_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_TTL_SECONDS=6
WORKER_DB_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_CANCELLATION_POLL_INTERVAL_MS=250

# ---------------------------------------------------------------------------
# Retry policy
# delay = RETRY_BASE_DELAY_SECONDS * 2^(attempt-1), capped at max delay
# ---------------------------------------------------------------------------
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_ATTEMPTS=5
RETRY_MAX_DELAY_SECONDS=300
RETRY_JITTER_RATIO=0.10
RETRY_SCHEDULER_POLL_INTERVAL_MS=250
RETRY_SCHEDULER_BATCH_SIZE=20

# Maximum UTF-8 JSON payload size accepted by POST /jobs.
PAYLOAD_MAX_BYTES=32768

# ---------------------------------------------------------------------------
# Security (development defaults)
# Ordinary `docker-compose up` stays loopback HTTP with auth off.
# Production overlay: docker-compose -f docker-compose.yml -f docker-compose.prod.yml
# ---------------------------------------------------------------------------
SECURITY_MODE=development
AUTH_ENABLED=false
RATE_LIMIT_ENABLED=false
DOCS_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_READ_BURST=120
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_WRITE_BURST=10
# Optional local auth (tests / manual). Prefer files in the secure profile.
# VIEWER_API_KEY=replace-with-generated-secret
# OPERATOR_API_KEY=replace-with-generated-secret

# ---------------------------------------------------------------------------
# Queue names
# ---------------------------------------------------------------------------
REDIS_CONSUMER_GROUP=job-workers
REDIS_STREAM_CRITICAL=jobs:critical
REDIS_STREAM_HIGH=jobs:high
REDIS_STREAM_NORMAL=jobs:normal
REDIS_STREAM_LOW=jobs:low
REDIS_DELAYED_ZSET=jobs:delayed
REDIS_DEAD_LETTER_STREAM=jobs:dead

# Weighted fairness. Each weight must be >= 1.
PRIORITY_WEIGHT_CRITICAL=8
PRIORITY_WEIGHT_HIGH=4
PRIORITY_WEIGHT_NORMAL=2
PRIORITY_WEIGHT_LOW=1

# Maximum first-run delay_seconds accepted by POST /jobs (7 days).
MAX_INITIAL_DELAY_SECONDS=604800

# Worker XREADGROUP block timeout. Short so Ctrl+C is responsive.
WORKER_READ_BLOCK_MS=1000
WORKER_RECLAIM_INTERVAL_MS=1000

# Outbox publisher
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=20
