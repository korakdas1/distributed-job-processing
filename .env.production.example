# Production-oriented overlay placeholders. Copy values into a gitignored `.env`
# or export them in the shell. Never commit generated secrets.
#
# Start:
#   docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Generate secrets and a local self-signed certificate first:
#   python scripts/generate_secrets.py
#   sh scripts/generate_tls.sh

SECURITY_MODE=production
AUTH_ENABLED=true
RATE_LIMIT_ENABLED=true
DOCS_ENABLED=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Abuse-protection defaults. Not performance SLAs.
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_READ_BURST=120
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_WRITE_BURST=10

# Prefer mounted files over raw environment values.
VIEWER_API_KEY_FILE=./secrets/viewer_api_key
OPERATOR_API_KEY_FILE=./secrets/operator_api_key
TLS_CERT_FILE=./secrets/tls/server.crt
TLS_KEY_FILE=./secrets/tls/server.key

# Required for the secure overlay. There is no development fallback.
# Do not use this to rotate an existing development Postgres password.
POSTGRES_PASSWORD=replace-with-secure-profile-password

# Public HTTPS edge. Loopback is the safe default. Use 0.0.0.0 only deliberately.
PUBLIC_BIND_ADDRESS=127.0.0.1
HTTPS_HOST_PORT=8443

# Development loopback mappings from docker-compose.yml may still appear after
# Compose v1 merges ports. They bind 127.0.0.1 only and are not public.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
DASHBOARD_HOST_PORT=3000
